# Supabase Configuration
# The self-hosted or cloud Supabase instance URL and public anon key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# n8n Automation Webhook
# The n8n webhook URL to trigger the article generation workflow
VITE_N8N_CONTENT_GENERATE_WEBHOOK=

# The n8n webhook URL to trigger website crawl & analysis
VITE_N8N_WEBSITE_ANALYZE_WEBHOOK=https://n8n.kuhaanelectric.com/webhook-test/website/analyze

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Used by the autonomous 48-hour AI agent to research trending industry topics.
# Users can configure this in AI Studio Secrets or directly in the App Settings.
DEEPSEEK_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
